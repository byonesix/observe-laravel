{
    "name": "byonesix/observe-laravel",
    "description": "Errors, logs and traces from Laravel to Observe.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-zlib": "*",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "suggest": {
        "ext-apcu": "Keeps circuit breaker state in shared memory instead of a file."
    },
    "autoload": {
        "psr-4": {
            "Observe\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Observe\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Observe\\Laravel\\ObserveServiceProvider"
            ],
            "aliases": {
                "Observe": "Observe\\Laravel\\Facades\\Observe"
            }
        }
    },
    "scripts": {
        "test": [
            "@php -d pcre.jit=1 vendor/bin/phpunit",
            "@php -d pcre.jit=0 vendor/bin/phpunit --filter 'HostileShapes|SecretPlacementFuzz|ScrubberLeakTable|ScrubberSharedCases'"
        ],
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
